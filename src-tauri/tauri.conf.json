{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoicePill",
  "version": "0.1.4",
  "identifier": "com.voicepill.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pill",
        "url": "pill.html",
        "title": "VoicePill",
        "width": 200,
        "height": 80,
        "minWidth": 48,
        "minHeight": 48,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "x": 80,
        "y": 80
      },
      {
        "label": "main",
        "url": "main.html",
        "title": "VoicePill",
        "width": 760,
        "height": 640,
        "minWidth": 520,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jawadkhan2/voicepill/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyOEVCMURDMUI3MDU1RTEKUldUaFZYQWIzTEdPRXQ4OWFYZlJhN2ZzOE05MnpCUjZlL1M5VzZtMmNsZmFiYjRKOGpLSStiS2wK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}



